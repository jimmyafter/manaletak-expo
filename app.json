{
  "expo": {
    "name": "Mana Letak",
    "slug": "manaletak",
    "scheme": "manaletak",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-sqlite",
      ["expo-camera", { "cameraPermission": "Mana Letak uses the camera so you can photograph where you put things. Photos stay on your phone." }]
    ],
   "android": {
      "package": "com.manaletak.app",
      "permissions": ["CAMERA"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E6F66"
      }
    },
    "ios": { "bundleIdentifier": "com.manaletak.app" },
    "experiments": { "typedRoutes": false }
  }
}
